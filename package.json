{
  "name": "forms-app",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @forms-app/shared build",
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev:api": "pnpm --filter @forms-app/api dev",
    "dev:web": "pnpm --filter @forms-app/web dev",
    "dev:webhook-consumer": "pnpm --filter @forms-app/webhook-consumer dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @forms-app/api prisma:migrate",
    "db:seed": "pnpm --filter @forms-app/api prisma:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
